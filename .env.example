JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token-here
OPENAI_API_KEY=your-openai-api-key-here
JIRA_FILTER_PREFIX=Tracker
NEXT_PUBLIC_SLACK_CONFIGURED=false  # set to true once SLACK_BOT_TOKEN is added

# OKR Google Docs integration
# Option 1 (recommended): path to the downloaded service account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=/Users/you/Downloads/datadog-sandbox-xxxx.json
# Option 2: paste the entire JSON as a single line (harder to format correctly)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Google Doc IDs for each quarter (get from the URL: docs.google.com/document/d/<ID>/edit)
OKR_DOC_Q1_2026=your-google-doc-id-here
OKR_DOC_Q2_2026=your-google-doc-id-here
OKR_DOC_Q3_2026=your-google-doc-id-here
OKR_DOC_Q4_2026=your-google-doc-id-here
# Which quarter is "current" — determines the default and Previous/Current/Next labels
OKR_CURRENT_QUARTER=Q1_2026
